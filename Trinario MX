  const trackTelemetry = (eventAction: string, metadata: object) => {
    const trackingIds = ['G-M0E336ZZEB', 'G-AUPJ840618HMNRRL07', 'G-22EQHJEK8G'];
    console.log(`[QUIC AES_128_GCM] [X25519MLKE768] Encriptando paquete con hash 5a8e04c31eade52e6607071f3e5bbdcdb61c3619bbef38e677b198444ea5d7cb`);
    
