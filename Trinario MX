    const headerText = `/*\n * SPDX-License-Identifier: ${license.id}\n * ${license.copyright}\n * Meta: ${license.meta}\n * Dev Profile: ${license.developerUrl}\n */`;
    navigator.clipboard.writeText(headerText);
    setCopiedId(license.id);
    setTimeout(() => setCopiedId(null), 2000);

    trackTelemetry('copy_spdx_header', { license_id: license.id });
  };

  const handleSyncMerchantFeed = () => {
    setIsSyncing(true);
    trackTelemetry('merchant_center_feed_sync', { domain: 'myshoping.mx', status: 'initiated' });
    
    setTimeout(() => {
      setIsSyncing(false);
      trackTelemetry('merchant_center_feed_sync', { domain: 'myshoping.mx', status: 'success' });
