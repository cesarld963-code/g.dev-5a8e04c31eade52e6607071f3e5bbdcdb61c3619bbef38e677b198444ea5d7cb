          <button onClick={() => { setTrinaryState(1); trackTelemetry('change_trinary_state', { target: 1 }); }} className="p-2.5 bg-emerald-950/20 border border-emerald-500/30 text-emerald-400 rounded-lg text-xs font-bold hover:bg-emerald-950/40 transition-all">MODO +1 (Expansión)</button>
        </div>
      </div>

      <div className="grid grid-cols-1 md:grid-cols-3 gap-6">
        
