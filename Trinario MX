  const filteredLicenses = useMemo(() => {
    return ALL_LICENSES.filter(license => 
      license.name.toLowerCase().includes(searchTerm.toLowerCase()) ||
      license.id.toLowerCase().includes(searchTerm.toLowerCase())
    );
  }, [searchTerm]);

